#!/bin/bash -p
# fortkeep: the person's command. A thin dispatcher over the scripts in the checkout it lives in; it decides nothing
# itself. Run with no argument for the commands and this copy's status.
# Started as `bash fortkeep`: start again in privileged mode, which ignores BASH_ENV, ENV and exported functions.
case $- in *p*) ;; *) exec /usr/bin/env -u BASH_ENV -u ENV /bin/bash -p "$0" "$@" ;; esac

# Its own checkout, through any chain of symlinks (~/.local/bin/fortkeep): readlink without -f.
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="${self%/*}/$link" ;; esac
done
SELF="$(cd "${self%/*}/.." && pwd -P)" || { echo "fortkeep: could not find its own folder" >&2; exit 2; }

. "$SELF/checks/lib/common.sh"
fortkeep_clean_start "$SELF/bin/fortkeep" "$@"
. "$SELF/checks/lib/repo.sh"
. "$SELF/checks/lib/ui.sh"
CONTROLS="${FORTKEEP_CONTROLS:-$SELF/controls/controls.json}"
LATEST="$FORTKEEP_REPORTS/latest/results.json"

die() { echo "fortkeep: $1" >&2; exit "${2:-2}"; }

help() {
  cat <<'EOF'
fortkeep: a security checkup for this Mac, run with your coding agent.

Commands
  fortkeep                                   a menu in a terminal; otherwise this help, the last check and what to do next
  fortkeep check [--only ID]... [--json]     check this Mac (read-only); exit 1 when something fails
  fortkeep explain ID                        the short lesson for one control
  fortkeep scan FOLDER                       is this repo safe to open? scans it, or the repos in it (read-only)
  fortkeep agent [claude|codex|opencode]     start your coding agent here, then type /posture
  fortkeep summary [--name NAME]             a posture summary you can share
  fortkeep update                            move to the newest signed release
  fortkeep version [--json]                  which release this is, and where
  fortkeep ci-template                       a GitHub workflow that scans every push and pull request of your repo
  fortkeep accept ID "reason" | --remove ID  keep a failed control as it is, with your reason
  fortkeep private add|remove|count          folders every check skips
  fortkeep baseline accept                   accept what is on this Mac now as your baseline
  fortkeep uninstall                         remove fortkeep's state, once its fixes are undone

Fixes run only inside your agent's session (fortkeep agent, then /fix), one at a time, after your answer.
EOF
}

when() {  # RUN_ID (20261119T140200Z) — "2026-11-19 14:02 UTC"
  printf '%s\n' "$1" | sed -E 's/^([0-9]{4})([0-9]{2})([0-9]{2})T([0-9]{2})([0-9]{2}).*/\1-\2-\3 \4:\5 UTC/'
}

# jq with checks/lib/results.jq loaded (the urgent rule, the order, the tally), ui.jq (the Terminal look) and $ctl,
# the controls by id.
rjq() {  # FILTER [jq arguments...] — raw output
  local f="$1"; shift
  jq -r -L "$FORTKEEP_LIB_DIR" --slurpfile c "$CONTROLS" \
    "include \"results\"; include \"ui\"; (\$c[0] | controls_by_id) as \$ctl | $f" "$@"
}
# The results of the controls given as jq's positional arguments (--args), or all of them when none is given.
PICK='$ARGS.positional as $only | [.results[] | select(($only | length) == 0 or (.id as $i | $only | index($i)))]'

# This copy's status: sets COPY, SIGNED, RUN (the last check's, or empty), LAST and NEXT.
status_facts() {
  local old facts urgent="" failing="" tally
  SIGNED="" RUN="" LAST="none yet"
  if fortkeep_verify_release "$SELF"; then
    SIGNED=1; COPY="$FORTKEEP_RELEASE_TAG, a signed release"
    if old="$(fortkeep_downgrade_from "$FORTKEEP_RELEASE_TAG")"; then COPY="$COPY, older than $old, which this Mac ran before"; fi
  else
    COPY="not a signed release: $FORTKEEP_RELEASE_PROBLEM"
  fi
  if [ -f "$LATEST" ]; then
    facts="$(rjq '[any(.results[]; urgent($ctl)), any(.results[]; .status == "FAIL" or .status == "ERROR"), .run,
      (.results | tally_text)] | @tsv' "$LATEST")" || die "could not read the last results, $LATEST"
    IFS=$'\t' read -r urgent failing RUN tally <<<"$facts"
    LAST="$(when "$RUN"): $tally"
  fi
  # Signs of live malware come before anything about this copy.
  if [ "$urgent" = true ]; then
    NEXT="first read docs/if-red.md in $SELF, or type /if-red in your agent: a check found signs of live malware"
  elif [ -z "$SIGNED" ]; then
    NEXT="don't run fixes from this copy: reinstall a signed release unless you changed it yourself"
  elif [ ! -f "$LATEST" ]; then
    NEXT="fortkeep agent, then type /posture (in Codex, \$posture); or fortkeep check on its own"
  elif [ "$failing" = true ]; then
    NEXT="fortkeep agent, then type /fix (in Codex, \$fix)"
  else
    NEXT="nothing to fix; check again now and then with fortkeep check"
  fi
}

status() {
  status_facts
  printf 'This copy    %s\nLast check   %s\nNext         %s\n' "$COPY" "$LAST" "$NEXT"
}

# Bare fortkeep at a terminal: the status, with the last check's score, above a menu of what to do.
menu() {
  local last folder choice=0
  status_facts
  last="$LAST"
  if [ -n "$RUN" ]; then
    last="$(when "$RUN")  $(rjq '.results | score($ctl; 10; 200)' "$LATEST")" || die "could not read the last results, $LATEST"
  fi
  ui_status "$SIGNED" "$COPY" "$last" "$NEXT"
  ui_menu "Check this Mac|every check, read-only" "Scan a repo|is a folder safe to open?" \
    "Fix with your coding agent|start claude, codex or opencode here" "Make a summary|one you can share" \
    "Update|move to the newest signed release" "Quit|" || choice=$?
  case "$choice" in
    1) check ;;
    2) # A folder dragged in from Finder comes with a trailing space and its spaces escaped: read undoes the escapes.
      # shellcheck disable=SC2162 # without -r on purpose, for those escapes
      IFS= read -e -p "Folder to scan: " folder || folder=""
      folder="${folder%"${folder##*[![:space:]]}"}"
      [ -n "$folder" ] || die "no folder given: nothing was scanned"
      scan "$folder" ;;
    3) agent ;;
    4) summary ;;
    5) exec "$SELF/checks/update.sh" ;;
    *) exit 0 ;;
  esac
}

# The order checks/lib/results.jq sets, one heading per group. PASS rows leave out their evidence (--json has it).
# Evidence comes from the Mac being checked: control characters become spaces, so none can rewrite the terminal.
table() {  # RESULTS_JSON [ID...] — the readable results; only those IDs when given
  local f="$1"; shift
  rjq 'def clean: tostring | gsub("[[:cntrl:]]"; " ");
    '"$PICK"' | map(. + {group: group($ctl)}) | group_by(.group) | sort_by(.[0].group | group_rank)
    | .[] | (.[0].group | clean),
        (ordered($ctl) | .[]
         | "  \(.status | clean | . + "         " | .[0:9]) \(.id | clean)  \(.title | clean)",
           (if .status == "PASS" then empty
            elif .status == "ACCEPTED" then "            your reason: \(.note // "" | clean)"
            elif (.evidence // "") != "" then "            \(.evidence | clean)" else empty end)),
        ""' --args "$@" < "$f"
}

check() {
  local json="" ids=() id facts failing urgent run macos tally rc=0 out
  local usage="usage: fortkeep check [--only ID]... [--json]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --only) [ $# -ge 2 ] || die "$usage"; ids+=("$2"); shift 2 ;;
      *) die "$usage" ;;
    esac
  done
  for id in ${ids[@]+"${ids[@]}"}; do set -- "$@" --only "$id"; done
  # run.sh's own summary would mix with the table or the JSON: all of its output goes to stderr, with its progress.
  # At a terminal, its progress becomes one updating line and its summary is left out: the table says it all.
  # It starts with the person's PATH, as the agent's /posture does: the checks inspect that PATH (which pip3 or
  # python3 comes first), and run.sh puts the system folders first for its own commands.
  if ui_on 2; then
    ui_hide_cursor 2
    { ui_ticker & t=$!
      PATH="$FORTKEEP_USER_PATH" "$SELF/checks/run.sh" "$@" 2>&1 >/dev/null; r=$?
      kill "$t"; wait "$t" 2>/dev/null; exit "$r"; } | ui_progress
    [ "${PIPESTATUS[0]}" -eq 0 ] || die "the check did not finish (its message is above)"
    ui_restore
  else
    PATH="$FORTKEEP_USER_PATH" "$SELF/checks/run.sh" "$@" >&2 || die "the check did not finish (its message is above)"
  fi
  [ -f "$LATEST" ] || die "the check wrote no results"
  facts="$(rjq "$PICK"' as $p | [any($p[]; .status == "FAIL" or .status == "ERROR"), any($p[]; urgent($ctl)), .run, .macos,
    (.results | tally_text)] | @tsv' --args ${ids[@]+"${ids[@]}"} < "$LATEST")" || die "could not read the results"
  IFS=$'\t' read -r failing urgent run macos tally <<<"$facts"
  [ "$failing" = false ] || rc=1
  if [ -n "$json" ]; then cat "$LATEST"; exit "$rc"; fi
  if ui_on 1; then
    rjq "$PICK"' as $p | check_view($ctl; $p; $w; $when; $self)' --argjson w "$(ui_cols)" --arg when "$(when "$run")" \
      --arg self "$SELF" --args ${ids[@]+"${ids[@]}"} < "$LATEST" || die "could not read the results"
    exit "$rc"
  fi
  out="$(table "$LATEST" ${ids[@]+"${ids[@]}"})" || die "could not read the results"
  printf 'fortkeep check: %s, macOS %s\n\n%s\n\n%s\n' "$(when "$run")" "$macos" "$out" "$tally"
  if [ "$urgent" = true ]; then
    echo "Urgent: this may mean the Mac is compromised now. Read $SELF/docs/if-red.md before anything else, or type /if-red in your agent."
  elif [ "$rc" -eq 1 ]; then
    echo "Next: fortkeep agent, then type /fix (in Codex, \$fix). Why one matters: fortkeep explain ID."
  fi
  exit "$rc"
}

scan() {
  # A folder named from where the person stands; checks/scan.sh takes absolute ones.
  # shellcheck disable=SC2088 # a literal ~/: checks/scan.sh expands it itself
  [ $# -ne 1 ] || case "$1" in /*|'~/'*) ;; .) set -- "$PWD" ;; *) set -- "$PWD/${1%/}" ;; esac
  exec "$SELF/checks/scan.sh" "$@"
}

explain() {
  [ $# -eq 1 ] || die "usage: fortkeep explain ID"
  case "$1" in [A-Z][A-Z]-[A-Z][A-Z]-[0-9][0-9]) ;; *) die "not a control id: $1 (for example BL-OS-01)" ;; esac
  [ -f "$SELF/teach/$1.md" ] || die "no lesson for $1"
  cat "$SELF/teach/$1.md"
}

agent() {
  local name="${1:-}" bin="" a
  case "$#:$name" in 0:|1:claude|1:codex|1:opencode) ;; *) die "usage: fortkeep agent [claude|codex|opencode]" ;; esac
  for a in ${name:-claude codex opencode}; do
    if bin="$(PATH="$FORTKEEP_USER_PATH" command -v "$a")"; then name="$a"; break; fi
  done
  [ -n "$bin" ] || die "${name:-no coding agent (claude, codex or opencode)} is not installed. $SELF/docs/agents.md says how each one works with fortkeep."
  echo "Starting $name in $SELF."
  case "$name" in
    claude) echo "Accept \"trust this folder\", then type /posture." ;;
    codex) echo "Trust the folder and choose \"Trust all and continue\" for its hooks (they are the guards), then type \$posture." ;;
    opencode) echo "Its guard plugin loads by itself. Type /posture." ;;
  esac
  cd "$SELF" || die "could not open $SELF"
  PATH="$FORTKEEP_USER_PATH" exec "$bin"
}

summary() {
  local name="" def run age out
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) [ $# -ge 2 ] || die "usage: fortkeep summary [--name NAME]"; name="$2"; shift 2 ;;
      *) die "usage: fortkeep summary [--name NAME]" ;;
    esac
  done
  [ -f "$LATEST" ] || die "no results yet: run fortkeep check first"
  run="$(jq -r .run "$LATEST")"
  if age="$(date -j -u -f '%Y%m%dT%H%M%SZ' "$run" +%s 2>/dev/null)"; then
    age=$(( ($(date -u +%s) - age) / 86400 ))
    [ "$age" -le 7 ] || echo "The last check is $age days old: run fortkeep check first for a current summary." >&2
  fi
  if [ -z "$name" ]; then
    [ -t 0 ] || die "give the name to show on the summary: fortkeep summary --name \"Your Name\""
    def="$("$SELF/summary/name.sh" 2>/dev/null)"
    printf 'Name to show on the summary [%s]: ' "$def"
    IFS= read -r name || name=""
    name="${name:-$def}"
    [ -n "$name" ] || die "no name given"
  fi
  out="$("$SELF/summary/build.sh" --name "$name")" || exit
  echo "$out"
  echo "${out%/*}/posture-summary.html is the same summary as a page: open it in your browser."
  echo "It is self-reported, and the reasons are your own words: read them before you share it."
}

version() {
  local json="" tag="" problem="" commit changes=false
  case "${1:-}" in --json) json=1 ;; '') ;; *) die "usage: fortkeep version [--json]" ;; esac
  commit="$(fortkeep_git "$SELF" rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null)" || commit=""
  fortkeep_verify_release "$SELF"
  case $? in 0) tag="$FORTKEEP_RELEASE_TAG" ;; 2) changes=true; problem="$FORTKEEP_RELEASE_PROBLEM" ;; *) problem="$FORTKEEP_RELEASE_PROBLEM" ;; esac
  if [ -n "$json" ]; then
    jq -n --arg v "$tag" --arg c "$commit" --argjson l "$changes" --arg p "$SELF" \
      '{version: (if $v == "" then null else $v end), commit: (if $c == "" then null else $c end), local_changes: $l, path: $p}'
    return
  fi
  if [ -n "$tag" ]; then echo "fortkeep $tag, a signed release"; else echo "fortkeep: not a release ($problem)"; fi
  echo "commit         ${commit:-none}"
  if [ "$changes" = true ]; then echo "local changes  yes"; else echo "local changes  none"; fi
  echo "folder         $SELF"
}

# A GitHub Actions workflow, on stdout, that runs this release's repo scanner over every push and pull request. It
# pins the release by its commit, so only a signed release can make one: a development copy has no release to pin.
ci_template() {
  local commit
  [ $# -eq 0 ] || die "usage: fortkeep ci-template"
  fortkeep_verify_release "$SELF" \
    || die "this copy is not a signed release ($FORTKEEP_RELEASE_PROBLEM), so there is no release for the workflow to pin. Run it from a signed release (fortkeep update)." 1
  commit="$(fortkeep_git "$SELF" rev-parse -q --verify 'HEAD^{commit}')" || die "could not read this copy's commit" 1
  sed -e "s/{{TAG}}/$FORTKEEP_RELEASE_TAG/g" -e "s/{{COMMIT}}/$commit/g" "$SELF/templates/fortkeep-scan.yml"
}

uninstall() {
  local id kind what blocks="" stays="" answer d c dirs=() link ours=""
  [ $# -eq 0 ] || die "usage: fortkeep uninstall"
  . "$SELF/fixes/lib/applied.sh"
  while IFS=$'\t' read -r id kind what; do
    [ -n "$id" ] || continue
    case "$kind" in stays) stays="$stays $id" ;; *) blocks="$blocks  $id  $what"$'\n' ;; esac
  done <<EOF
$(fx_applied)
EOF
  if [ -n "$blocks" ]; then
    echo "These fixes are still applied, and what they installed needs fortkeep:"
    printf '%s' "$blocks"
    echo
    echo "Undo each one first: fortkeep agent, ask it to undo the fix, and answer Undo <ID>. Its backup puts your files back."
    echo "Then run fortkeep uninstall again. Nothing was removed."
    exit 1
  fi
  echo "fortkeep never runs sudo. These admin changes from its lessons don't need fortkeep and keep protecting this Mac."
  echo "To remove them anyway, type them yourself in the Terminal app, only those you made from a fortkeep lesson:"
  echo
  awk '/<!-- fortkeep-uninstall-admin:end -->/ { on = 0 } on && !/```/ { sub(/^   /, "  "); print }
       /<!-- fortkeep-uninstall-admin:start -->/ { on = 1 }' "$SELF/docs/what-fortkeep-touches.md"
  echo
  echo "Everything fortkeep writes: $SELF/docs/what-fortkeep-touches.md"
  echo
  [ -z "$stays" ] || { echo "Kept, as they work without fortkeep:$stays. Their backups go with the state folder."; echo; }
  # fortkeep's own folders, named once, from the helpers that name them: the settings (fortkeep_state_file, in the
  # account's own home folder, which fortkeep_clean_start also made HOME) and the backups' folder. The baselines
  # (fortkeep_baseline_dir) live in the settings folder.
  c="$(fortkeep_state_file x)" || die "could not read your home folder from your account"
  dirs=("${c%/*}" "${FORTKEEP_BACKUPS%/*}")
  for d in "${dirs[@]}"; do case "$d" in /?*/fortkeep) ;; *) die "won't remove $d: it is not one of fortkeep's folders" ;; esac; done
  link="$(fortkeep_home)/.local/bin/fortkeep" || die "could not read your home folder from your account"
  [ -L "$link" ] && [ "$(fortkeep_realpath "$link")" = "$SELF/bin/fortkeep" ] && ours=1
  echo "fortkeep's own files outside this folder:"
  for d in "${dirs[@]}"; do
    [ -d "$d" ] && echo "  $(fortkeep_tilde "$d")  ($(find "$d" -mindepth 1 -maxdepth 1 | sed 's#.*/##' | sort | paste -sd, - | sed 's/,/, /g'))"
  done
  [ -z "$ours" ] || echo "  $(fortkeep_tilde "$link")  (the link to this copy)"
  # They hold the release signers this Mac trusts: only the person, typing in a terminal, removes them; never an
  # agent or a piped yes. /bin/ps is fixed here on purpose: no environment variable may switch the check off.
  . "$SELF/checks/lib/agent.sh"
  fortkeep_require_person /bin/ps
  printf 'Remove them? Type yes to remove: '
  IFS= read -r answer || answer=""
  echo
  [ "$answer" = yes ] || { echo "Nothing was removed."; exit 1; }
  rm -rf "${dirs[@]}" || die "could not remove every state folder" 1
  [ -z "$ours" ] || rm -f "$link" || die "could not remove $(fortkeep_tilde "$link")" 1
  echo "Removed. The last step is yours: close your coding agent, then delete this folder: $SELF"
  echo "If you installed fortkeep with Homebrew, also type: brew uninstall fortkeep"
}

case "${1:-}" in
  '') if ui_on 1 && [ -t 0 ]; then menu; else help; echo; status; fi ;;
  -h|--help|help) help ;;
  check) shift; check "$@" ;;
  explain) shift; explain "$@" ;;
  agent) shift; agent "$@" ;;
  summary) shift; summary "$@" ;;
  scan) shift; scan "$@" ;;
  update) shift; exec "$SELF/checks/update.sh" "$@" ;;
  version) shift; version "$@" ;;
  ci-template) shift; ci_template "$@" ;;
  accept) shift; exec "$SELF/checks/accept.sh" "$@" ;;
  private) shift; exec "$SELF/checks/private.sh" "$@" ;;
  baseline) shift; exec "$SELF/checks/baseline.sh" "$@" ;;
  uninstall) shift; uninstall "$@" ;;
  *) help >&2; exit 2 ;;
esac
