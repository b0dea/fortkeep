INLINE_RISK = re.compile(r'''\b(?:curl|wget)\b|fetch\(|require\(\s*\\?["'](?:node:)?https?\\?["']|\burlopen\(|\batob\(|Buffer\.from\([^)]{0,200}base64|b64decode|\beval\(|\bexec\(|child_process|Function\(''')

def exec_rules(s):
    return [n for n, found in EXEC_RULES if found(s)]

def exec_verdict(s):
    """(severity, rule) for S when it fetches or runs code, else None. Inline node or python alone is how hooks and
    install scripts are written: HIGH only when it also fetches, decodes or evaluates code."""
    rules = exec_rules(s)
    if not rules:
        return None
    strong = [n for n in rules if n not in INLINE]
    if strong:
        return 'HIGH', strong[0]
    return ('HIGH' if INLINE_RISK.search(s) else 'WARN'), rules[0]

def exec_line_verdict(text):
    """The first HIGH verdict of an uncommented line, else the first WARN one, else None. Inline code can span lines (a
    quoted or YAML block script), so a WARN is HIGH when the uncommented text fetches, decodes or evaluates code."""
    warn = None; code = []
    for line in re.sub(r'\\\r?\n', ' ', text).splitlines():  # a command continued with \ is one line
        if line.lstrip().startswith('#'):
            continue
        code.append(line)
        v = exec_verdict(line)
        if v and v[0] == 'HIGH':
            return v
        warn = warn or v
    if warn and INLINE_RISK.search('\n'.join(code)):
        return 'HIGH', warn[1]
    return warn

