TO_SHELL = re.compile(r'\|\s*(?:sudo\s+)?(?:/[^\s|]{0,100}/)?(?:env\s+)?(?:(?:ba|z|da|k)?sh|node|python[0-9.]*)\b')

def piped_download(s):
    # Anchored on the pipe, then a look back within its own pipeline stage: a pattern read from curl forward would
    # rescan the rest of the line once for every curl in it.
    for m in TO_SHELL.finditer(s):
        stage = s[max(0, m.start() - 500):m.start()]
        if DOWNLOAD.search(stage[max(stage.rfind('|'), stage.rfind('\n')) + 1:]):
            return True
    return False

