def may_hit(text):
    # One pass over the whole file before the per-line loop: no marker can match without its anchor. Plain substring
    # checks: an alternation of the patterns scans slower than the loop.
    return any(a in text for _, _, anchors in HI for a in anchors) or any(a in text for a in DEAD_DROP_ANCHORS)

def marker_hits(lines, patterns):
    """{line number: marker names} for LINES, long whitespace runs squeezed, weighed over the whole file."""
    hits = {}
    for i, line in enumerate(lines, 1):
        sq = SQUEEZE.sub(' ', line) if len(line) > 400 else line
        ids = [n for n, r, _ in patterns if r.search(sq)]
        if ids:
            hits[i] = ids
    keep = set(weigh([n for ids in hits.values() for n in ids]))
    if keep - set(WEAK_HI):  # a strong marker already flags the file: weak-only lines (a bundle's _$_ names) add nothing
        return {i: ids for i, ids in hits.items() if set(ids) - set(WEAK_HI)}
    return {i: [n for n in ids if n in keep] for i, ids in hits.items() if keep.intersection(ids)}

def suspicious(text):
    """2 when a part of a large file holds a payload marker, weighed as a file is (so a bundle's _$_ names don't count);
    1 when it names a dead-drop or C2 host, which only code or a wallet beside it makes HIGH; else 0."""
    found = [r for _, r, anchors in HI if any(a in text for a in anchors)]
    if found:
        sq = SQUEEZE.sub(' ', text)
        if weigh([n for n, r, _ in HI if r in found and r.search(sq)]):
            return 2
    if any(a in text for a in DEAD_DROP_ANCHORS) and DEAD_DROP.search(text):
        return 1
    low = text.lower()
    return int(any(a in low for a in C2_ANCHORS) and bool(C2.search(text)))

def dead_drop(line, wallet):
    """HIGH for a dead-drop host after a padded gap or in a file with a C2 WALLET, WARN for one alone, else None."""
    m = DEAD_DROP.search(line)
    if not m:
        return None
    return 'HIGH' if wallet or GAP.search(line, 0, m.start()) else 'WARN'

